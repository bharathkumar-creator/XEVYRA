# ============================================================
# XEVYRA Fitness Platform - STAGING Environment Template
# ============================================================

# Environment Identifier
NODE_ENV=staging
PORT=4000
API_BASE_URL=https://api-staging.xevyra.fit
WEB_APP_URL=https://staging.xevyra.fit

# MongoDB Atlas Staging Database (Dedicated staging cluster/database)
# Never use production database credentials here
MONGODB_URI=mongodb+srv://xevyra_staging_app:<DB_PASSWORD>@xevyra-staging-cluster.abcde.mongodb.net/xevyra_staging?retryWrites=true&w=majority&appName=XevyraStagingCluster
MONGODB_DB_NAME=xevyra_staging
MONGODB_MAX_POOL_SIZE=25
MONGODB_MIN_POOL_SIZE=5

# Firebase Admin SDK (Dedicated Staging Project)
FIREBASE_PROJECT_ID=xevyra-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@xevyra-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<STAGING_PRIVATE_KEY_HERE>\n-----END PRIVATE KEY-----\n"

# Firebase Client (Staging Project Web Config)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyStagingClientApiKeyExample123456
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xevyra-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xevyra-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xevyra-staging.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=987654321098
NEXT_PUBLIC_FIREBASE_APP_ID=1:987654321098:web:stagingabcdef123456
NEXT_PUBLIC_API_URL=https://api-staging.xevyra.fit/api/v1

# OpenAI API (Staging Key with strict usage caps)
OPENAI_API_KEY=sk-proj-staging-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=30000

# Redis Cache & Rate Limiting (Staging cluster)
REDIS_URL=redis://xevyra-staging-redis.internal:6379
REDIS_ENABLED=false

# Security & CORS (Staging Allowed Origins)
CORS_ORIGIN=https://staging.xevyra.fit,https://api-staging.xevyra.fit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
