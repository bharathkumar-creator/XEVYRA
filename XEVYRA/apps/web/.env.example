# ============================================================
# @xevyra/web Client Environment Configuration (.env.example)
# Only NEXT_PUBLIC_* variables are bundled into the client browser
# ============================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Firebase Client Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment123456
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xevyra-fitness.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xevyra-fitness
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xevyra-fitness.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
