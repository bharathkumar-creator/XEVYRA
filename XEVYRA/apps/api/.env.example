# ============================================================
# @xevyra/api Environment Configuration (.env.example)
# ============================================================

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/xevyra_dev
MONGODB_DB_NAME=xevyra_dev
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# Firebase Admin SDK
FIREBASE_PROJECT_ID=xevyra-fitness
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@xevyra-fitness.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OpenAI
OPENAI_API_KEY=sk-proj-dummy-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=30000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
