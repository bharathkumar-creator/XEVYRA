# ============================================================
# XEVYRA Fitness Tracking Platform - Environment Configuration
# ============================================================

# Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/xevyra_dev
MONGODB_DB_NAME=xevyra_dev
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# Firebase Admin SDK (Backend Identity Verification)
# Required for verifying client Firebase ID tokens
FIREBASE_PROJECT_ID=xevyra-fitness
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@xevyra-fitness.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Client (Public / Web)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment123456
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xevyra-fitness.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xevyra-fitness
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xevyra-fitness.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# OpenAI API (Backend Only - Never expose to clients)
OPENAI_API_KEY=sk-proj-dummy-openai-key-dev-only
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=30000

# Redis Cache & Rate Limiting (Optional in local dev)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
