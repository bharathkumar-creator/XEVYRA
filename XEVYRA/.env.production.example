# ============================================================
# XEVYRA Fitness Platform - PRODUCTION Environment Template
# (Do NOT commit real production secrets to version control)
# ============================================================

# Environment Identifier
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.xevyra.fit
WEB_APP_URL=https://xevyra.fit

# MongoDB Atlas Production Database (Dedicated production replica set / M10+ tier)
MONGODB_URI=mongodb+srv://xevyra_prod_app:<PROD_DB_PASSWORD>@xevyra-prod-cluster.xyz12.mongodb.net/xevyra_production?retryWrites=true&w=majority&appName=XevyraProdCluster
MONGODB_DB_NAME=xevyra_production
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Firebase Admin SDK (Production Project)
FIREBASE_PROJECT_ID=xevyra-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-prod@xevyra-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<PROD_SECRET_STORED_IN_KEYVAULT>\n-----END PRIVATE KEY-----\n"

# Firebase Client (Production Project Web Config)
NEXT_PUBLIC_FIREBASE_API_KEY=<PROD_FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xevyra-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xevyra-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xevyra-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<PROD_MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<PROD_FIREBASE_APP_ID>
NEXT_PUBLIC_API_URL=https://api.xevyra.fit/api/v1

# OpenAI API (Production Key with automated monitoring & rate caps)
OPENAI_API_KEY=<PROD_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=30000

# Redis Cache & Rate Limiting (Production ElastiCache / Redis Cloud)
REDIS_URL=rediss://default:<REDIS_PASSWORD>@xevyra-prod-redis.internal:6379
REDIS_ENABLED=true

# Security & CORS (Production Locked Origins)
CORS_ORIGIN=https://xevyra.fit,https://www.xevyra.fit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
